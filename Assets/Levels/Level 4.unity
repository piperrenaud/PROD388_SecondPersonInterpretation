  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroAndEnd
  animator: {fileID: 2019689769}
  fadeParent: {fileID: 2019689767}
  dialogueManager: {fileID: 1815982490}
  playerMovement: {fileID: 1635768184}
  objectPosession: {fileID: 1635768187}
  protagWander: {fileID: 1100837095}
  linearDialogueLines: {fileID: 788227375}
  introLines:
  - Woah, this room got really messed up...
  - The exits completely blocked!
  - How am I supposed to even get to it?
  - I can't move all those things by myself.
  - I just want my Dad...
  endLines:
  - I knew someone was helping me this whole time!
  - We can find our way out together then.
  - You seem to know what you're doing.
  - Lead the way!
  instructions:
  - Now you can move freely in the worldspace.
  - Use WASD to move around and your mouse to look.
  - Click E to interaction with objects and LeftShift to stop the interaction
