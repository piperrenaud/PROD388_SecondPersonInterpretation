  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinearDialogueLines
  dialogueManager: {fileID: 1815982490}
  dialogueLines:
  - Woah... the objects are moving on their own. That's kinda freaky.
  - Uh... did that thing just move by itself?
  - Could someone actually be watching out for me?
  - Maybe those strange things happening before weren't coincidences...
  - Whoever you are... thank you for helping me.
  - I hope I get the chance to meet whoever's been helping me.
  minimumDelay: 10
  maximumDelay: 30
