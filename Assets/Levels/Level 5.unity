  m_Script: {fileID: 11500000, guid: b678a51d8f7344c47bc56debfa430620, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProtagDialogue
  dialogueManager: {fileID: 577360777}
  introEnding: {fileID: 1196962377}
  puzzleOneDialogues:
  - It looks like I have a button thingy in my room.
  - Do you have one?
  - Buttons should always be pressed.
  puzzleTwoDialogues:
  - Aw man I hate flipping levers.
  - How many am I even supposed to flip?!
  - Hang on, theres a bunch of arrows on the wall here.
  - Up, up, down, down, then up again.
  - You can figure it out.
  puzzleTwoDialogueTwo:
  - Wait did the arrows help you??
  - Yayy!
  - Okay, now do you have any arrows for me??
  puzzleThreeDialogues:
  - Hmm theres nothing in this room.
  - Maybe we gotta dig around for some clues.
  puzzleThreeDialoguesTwo:
  - Why won't my key open my door??
  - Hmmm...
  - Wait a second.
  - Maybe they open each others doors!
  - Quick, let's swap places!!
  doorOne: Woah my door just opened. Working together works!
  doorTwo: Yay it worked! Let's keep going.
  doorThree: Oh my gosh we made it!
  buttonParent: {fileID: 377538031}
  wrongAnswerLines:
  - Aw man that didn't do anything.
  - I don't think that worked.
  - Erm that one didn't work.
  - I don't think you gave me the right answer.
  playerDoor: {fileID: 1757166661}
  protagDoor: {fileID: 807583213}
  audioSource: {fileID: 1416904273}
  fiveLeversAudio: {fileID: 8300000, guid: 41e4fb17e488a734cb0a7444f0c06078, type: 3}
  minimumDelay: 10
  maximumDelay: 30
