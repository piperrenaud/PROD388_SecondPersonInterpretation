  rumblingAudio: {fileID: 488429818}
  collapseAudio: {fileID: 1424432732}
  otherElectrical: {fileID: 1927484266}
  dialogueManager: {fileID: 1199888270}
  lines:
  - And...thats where we're going to leave things.
  - What you just experienced was her memory.
  - A perfectly normal Bring Your Child To Work Day.
  - Well.
  - Mostly normal.
  - From this point on, things are a little different.
  - You won't be hearing from me anymore.
  - Instead, you'll be hearing from her.
  - She's lost somewhere inside this facility, and she needs to find her way back
    to her dad.
  - Your job is simple.
  - Get her there safely.
  - Don't fail her.
  audioToKeepPlaying: {fileID: 1199888269}
  mechanicalArm: {fileID: 1927484261}
  nextScene: Level 2
