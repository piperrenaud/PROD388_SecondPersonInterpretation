  m_Script: {fileID: 11500000, guid: 4971c5eb32d68c6419c2b82ec69e3fa3, type: 3}
  m_Name: MechanicalPostInteraction
  m_EditorClassIdentifier: Assembly-CSharp::NarratorEventData
  eventID: MechanicalPostInteraction
  dialogueLines:
  - You already broke it, what more do you possibly want to do with it?
  - "It\u2019s already broken. What exactly are you planning to accomplish now?"
  - "You\u2019ve literally broken it already. What more could there possibly be?"
  - "It\u2019s broken, you know. I\u2019m not sure what you\u2019re expecting to
    happen now"
  - You already managed to break the thing. Maybe leave it alone now?
  - What more do you want from it? You already destroyed its entire purpose
  - "It\u2019s not going to magically start working again. You already broke it"
  - "You broke it. The experiment is over. There\u2019s nothing left to do here"
  - "You\u2019ve already broken the robot. Unless you\u2019re planning on making
    it even more broken"
  - "Okay, you broke it. I think you\u2019ve gotten everything you\u2019re going
    to get out of it"
  canRepeat: 1
  priority: 3
