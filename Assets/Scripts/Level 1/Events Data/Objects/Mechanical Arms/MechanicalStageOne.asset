  m_Script: {fileID: 11500000, guid: 4971c5eb32d68c6419c2b82ec69e3fa3, type: 3}
  m_Name: MechanicalStageOne
  m_EditorClassIdentifier: Assembly-CSharp::NarratorEventData
  eventID: MechanicalStageOne
  dialogueLines:
  - "I feel like it\u2019s not exactly strong enough to handle all this touching"
  - "I\u2019m starting to think this thing wasn\u2019t designed for quite this much
    attention"
  - "You\u2019re really putting this thing through its paces with all that touching"
  - "I don\u2019t think it was built to survive you constantly messing with it"
  - "At this rate, I\u2019m not sure this thing is going to hold up"
  - "You might want to ease up a little. I don\u2019t think it\u2019s built for this
    much interaction"
  - "I\u2019m beginning to think you\u2019re asking a bit too much of this poor thing"
  - "This thing really wasn\u2019t designed to be poked and prodded this much, was
    it?"
  - "I feel like you\u2019re testing its durability more than anything else"
  - "Maybe give it a break. I don\u2019t think it can handle much more of your attention"
  canRepeat: 1
  priority: 3
