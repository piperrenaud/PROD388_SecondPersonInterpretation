  m_Script: {fileID: 11500000, guid: 4971c5eb32d68c6419c2b82ec69e3fa3, type: 3}
  m_Name: DangerSignSuspicious
  m_EditorClassIdentifier: Assembly-CSharp::NarratorEventData
  eventID: DangerSignSuspicious
  dialogueLines:
  - "Are you actually still reading it? Because if you are, that\u2019s a little
    concerning. Let\u2019s move on"
  - "Wait, are you seriously still standing here reading the sign? Okay, that\u2019s
    enough. Let\u2019s go"
  - "You\u2019re still reading it? I\u2019m starting to think we should probably
    find something else to do"
  - "Are you genuinely still trying to read that? It hasn\u2019t changed, you know.
    Let\u2019s move on"
  - "You\u2019re still staring at the sign? Okay, I\u2019m officially concerned.
    Come on, let\u2019s go"
  - "If you\u2019re still reading that sign, we might have a problem. Let\u2019s
    just move along"
  - "You\u2019re really still looking at it? I promise there isn\u2019t a secret
    message hidden in there"
  - "Are you waiting for the sign to say something different? Because it\u2019s not
    going to. Let\u2019s move on"
  - "You\u2019re still here? Seriously? Okay, let\u2019s find something else to look
    at"
  - "If you\u2019re actually still reading that sign, I think we\u2019ve spent enough
    time here. Let\u2019s go"
  canRepeat: 1
  priority: 3
