  m_Script: {fileID: 11500000, guid: 4971c5eb32d68c6419c2b82ec69e3fa3, type: 3}
  m_Name: PlayerStandingStillTwo
  m_EditorClassIdentifier: Assembly-CSharp::NarratorEventData
  eventID: PlayerStandingStillTwo
  dialogueLines:
  - "You\u2019re still not doing anything. Please tell me this is a mechanical failure
    and not a reflection on my game"
  - "You\u2019re still standing there? I\u2019m really hoping that\u2019s a mechanical
    failure and not because my game is boring"
  - "Still nothing? Tell me your controls have stopped working and this isn\u2019t
    just my game failing to entertain you"
  - "You\u2019re not doing anything again. I\u2019d like to believe something\u2019s
    broken rather than accept that my game is boring"
  - Still standing completely still? Please tell me this is a technical issue and
    not you losing interest in my game
  canRepeat: 1
  priority: 1
