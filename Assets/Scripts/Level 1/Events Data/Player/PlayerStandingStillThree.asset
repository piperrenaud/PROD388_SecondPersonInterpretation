  m_Name: PlayerStandingStillThree
  m_EditorClassIdentifier: Assembly-CSharp::NarratorEventData
  eventID: PlayerStandingStillThree
  dialogueLines:
  - "Why are you still doing nothingggggg? For my mental health, I\u2019m just going
    to assume you\u2019ve gone AFK"
  - "Why are you STILL standing there? Please tell me you\u2019ve gone AFK because
    I cannot handle this"
  - "You\u2019re doing absolutely nothinggggg. I\u2019m choosing to believe you\u2019ve
    gone AFK for my own sanity"
  - "Why have you stopped moving? I\u2019m just going to assume you\u2019re AFK because
    the alternative is too painful"
  - "You\u2019re still not movingggggg. Please be AFK. I need to believe this isn\u2019t
    my game\u2019s fault"
