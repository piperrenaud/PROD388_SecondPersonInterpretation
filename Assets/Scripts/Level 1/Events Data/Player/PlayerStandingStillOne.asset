  m_Script: {fileID: 11500000, guid: 4971c5eb32d68c6419c2b82ec69e3fa3, type: 3}
  m_Name: PlayerStandingStillOne
  m_EditorClassIdentifier: Assembly-CSharp::NarratorEventData
  eventID: PlayerStandingStillOne
  dialogueLines:
  - "You\u2019ve been standing still for a while. Is my game really that boring to
    you?"
  - "You\u2019ve been standing there doing absolutely nothing. Am I really that boring?"
  - "Wow, you\u2019ve been standing still for quite a while. Is the game putting
    you to sleep?"
  - "You\u2019ve been completely motionless for a bit. I hope my game isn\u2019t
    that uninteresting"
  - Still standing there? Damn, I must be doing a great job of keeping you entertained
  canRepeat: 1
  priority: 1
