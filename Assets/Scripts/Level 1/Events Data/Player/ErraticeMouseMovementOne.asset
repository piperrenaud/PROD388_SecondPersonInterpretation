  m_Script: {fileID: 11500000, guid: 4971c5eb32d68c6419c2b82ec69e3fa3, type: 3}
  m_Name: ErraticeMouseMovementOne
  m_EditorClassIdentifier: Assembly-CSharp::NarratorEventData
  eventID: ErraticMouseMovementOne
  dialogueLines:
  - "Okay, you really don\u2019t need to move the mouse that much. My head is spinning"
  - "Easy there, you\u2019re moving that mouse like you\u2019re trying to break the
    camera"
  - Okay, enough with the frantic mouse movements. Give me a second to catch up
  - "Okay, calm down with the mouse movements. You\u2019re going to make me dizzy"
  - "Alright, easy with the mouse. I\u2019m starting to feel dizzy just watching
    this"
  - Okay, slow down. All this mouse movement is making my head spin
  - Whoa, okay, maybe ease up on the mouse a little. I can barely keep up
  - "Alright, that\u2019s enough spinning. I\u2019m getting dizzy over here"
  - "Okay, relax with the mouse movements. I\u2019m starting to lose track of what\u2019s
    happening"
  - "Please slow down with the mouse. I\u2019m getting motion sick just thinking
    about it"
  canRepeat: 1
  priority: 1
