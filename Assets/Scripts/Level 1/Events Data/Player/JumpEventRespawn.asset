  m_Script: {fileID: 11500000, guid: 4971c5eb32d68c6419c2b82ec69e3fa3, type: 3}
  m_Name: JumpEventRespawn
  m_EditorClassIdentifier: Assembly-CSharp::NarratorEventData
  eventID: JumpEventRespawn
  dialogueLines:
  - "Okay, we\u2019re going to reset now. This time, you better stop pressing Space."
  - "Alright, that\u2019s enough. Let\u2019s reset, and please leave the Space key
    alone."
  - "We\u2019re starting over. And this time, no more pressing Space."
  - Okay, reset time. Surely you can resist the urge to press Space this time.
  - "Let\u2019s try that again. This time, I\u2019d really appreciate it if you stopped
    pressing Space."
  - "Fine, we\u2019ll reset. But this time, keep your fingers away from that Space
    key."
  - 'Alright, back to the beginning. And remember: Space still does nothing.'
  - "We\u2019re going to start over now. Please, for the narrator\u2019s sanity,
    stop pressing Space."
  - Okay, everything is being reset. This time, try not to press Space repeatedly.
  - Time for a fresh start. And this time, you better leave Space alone.
  canRepeat: 1
  priority: 1
