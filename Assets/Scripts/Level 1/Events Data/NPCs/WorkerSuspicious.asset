  m_Script: {fileID: 11500000, guid: 4971c5eb32d68c6419c2b82ec69e3fa3, type: 3}
  m_Name: WorkerSuspicious
  m_EditorClassIdentifier: Assembly-CSharp::NarratorEventData
  eventID: WorkerSuspicious
  dialogueLines:
  - "You\u2019ve officially crossed from messing around into just being annoying"
  - "Seriously, you\u2019re doing this on purpose now. I\u2019m not even questioning
    it"
  - "Oh, come on. You know exactly what you\u2019re doing, and it\u2019s getting
    annoying"
  - "Okay, I\u2019m beginning to suspect you\u2019re enjoying how annoyed I\u2019m
    getting"
  - "Right, you win. You\u2019ve successfully made this incredibly annoying. Happy
    now?"
  - "Okay, you\u2019re doing this on purpose now, and it\u2019s getting annoying
    real quick"
  - "Right, you\u2019re definitely doing this just to annoy me now"
  - "Okay, we\u2019ve established you\u2019re doing this deliberately. Can we stop
    now?"
  - "Oh, you\u2019re absolutely doing this on purpose, aren\u2019t you?"
  - Okay, this has gone from funny to incredibly annoying very quickly
  - "You\u2019re not even pretending this is accidental anymore, are you?"
  - "Right, I get it. You\u2019re trying to annoy me. Congratulations, it\u2019s
    working"
  - "Okay, you\u2019re really starting to test my patience now"
  - "Oh my god, you\u2019re doing this deliberately. I can tell"
  - "Alright, enough. I know exactly what you\u2019re trying to do now"
  - "You\u2019re really committed to being annoying today, huh?"
  - Okay, this is getting old incredibly fast
  - "I\u2019m starting to think you\u2019re doing this purely to get a reaction out
    of me"
  - Right, because apparently annoying me is your main objective now
  - Okay, I get the joke. You can stop doing it now
  canRepeat: 1
  priority: 3
