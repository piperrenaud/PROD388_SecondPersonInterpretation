  m_Script: {fileID: 11500000, guid: 4971c5eb32d68c6419c2b82ec69e3fa3, type: 3}
  m_Name: DadSuspicious
  m_EditorClassIdentifier: Assembly-CSharp::NarratorEventData
  eventID: DadSuspicious
  dialogueLines:
  - "Okay, now you\u2019re only talking to him to annoy me, aren\u2019t you?"
  - "Oh, come on. You\u2019re deliberately talking to him just to get on my nerves
    now"
  - Right, so now this is just you trying to annoy me, is it?
  - "You\u2019re not even here to talk to him anymore. You\u2019re just doing it
    to bother me"
  - "Okay, I see what you\u2019re doing. You\u2019re talking to him purely to annoy
    me"
  - "Seriously? Now you\u2019re going back to him just because you know it annoys
    me"
  - "Oh my god, you\u2019re doing this on purpose now, aren\u2019t you?"
  - Right, because apparently talking to your dad repeatedly is your new way of irritating
    me
  - You really are just talking to him for the sole purpose of getting a reaction
    out of me, huh?
  - "Okay, you\u2019ve officially turned talking to your dad into an attempt to annoy
    me. Congratulations"
  canRepeat: 1
  priority: 3
