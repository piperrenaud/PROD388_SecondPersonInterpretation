  dialogueNodes:
  - nodeID: intro
    lines:
    - text: You know what's happening, dont you?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    choices:
    - choiceText: No
      nextNodeID: no_answer
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    - choiceText: You're in a game
      nextNodeID: game_answer
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    - choiceText: You're not supposed to be able to see me
      nextNodeID: see_answer
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    nextNodeID: 
  - nodeID: no_answer
    lines:
    - text: You're lying
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - text: That's okay
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - text: I can find out myself
      onLineStart:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 1201951828}
            m_TargetAssemblyTypeName: BranchingDialogue, Assembly-CSharp
            m_MethodName: ShowDebug
            m_Mode: 5
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: Press button on terminal
              m_BoolArgument: 0
            m_CallState: 2
    - text: There.
      onLineStart:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 1201951828}
            m_TargetAssemblyTypeName: BranchingDialogue, Assembly-CSharp
            m_MethodName: ShowDebug
            m_Mode: 5
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: Press button on terminal
              m_BoolArgument: 0
            m_CallState: 2
    - text: Did you feel that?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    choices: []
    nextNodeID: 
  - nodeID: game_answer
    lines:
    - text: A game
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - text: Like... a computer game?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    choices:
    - choiceText: Yes
      nextNodeID: yes_answer
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    - choiceText: Something like that
      nextNodeID: something_answer
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    - choiceText: You're an NPC
      nextNodeID: npc_answer
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    nextNodeID: 
  - nodeID: see_answer
    lines:
    - text: But I can
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
    - text: Can't I?
      onLineStart:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 1201951828}
